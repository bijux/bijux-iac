{
  "version": 4,
  "classes": {
    "foundation": {
      "description": "Control-plane repositories for governance and shared standards."
    },
    "hubs": {
      "description": "Documentation and learning hubs for the Bijux family."
    },
    "rust": {
      "description": "Rust-first product repositories."
    },
    "python": {
      "description": "Python-first product repositories."
    }
